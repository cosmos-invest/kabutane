性があり、または株式の売却を行う可能性もある。保有目的及び重要提案行為について：株主価値向上に資する、資本政策及びコーポレートガバナンス等に関する助言及び提案。提案の内容については、以下を含む。1. 資本政策の変更（増配及び自己株式取得）2. 事業及び資産の譲渡（株主価値向上に資することのない資産及び事業（子会社を含む））3. 事業及び資産の譲受け（業界再編についての提案）4. 株式の非公開化（MBOを含む）提出者は、発行会社の株主価値の向上を目的として、発行会社との対話を通じ、上記について口頭又は書簡により提案を行っており、または今後行う可能性がある。","important_proposal":true,"important_proposal_text":"該当なし","description":"大量保有報告書","parent_doc_id":"","source_url":"https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Y5E5"}],"9211":[{"doc_id":"S100YP38","security_code":"9211","issuer_name":"株式会社エフ・コード","filer_name":"アセンダー・キャピタル・リミテッド","report_type":"変更報告書","event_kind":"IMPORTANT_PROPOSAL","submitted_at":"2026-07-10 15:32","obligation_date":"2026-07-03","current_ratio_pct":4.21,"previous_ratio_pct":5.28,"change_pct_point":-1.07,"purpose":"重要提案行為等を行うこと","important_proposal":true,"important_proposal_text":"重要提案行為等を行う可能性がある","description":"変更報告書","parent_doc_id":"","source_url":"https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100YP38"}],"9271":[{"doc_id":"S100YPXH","security_code":"9271","issuer_name":"和心","filer_name":"吉村英毅","report_type":"変更報告書","event_kind":"DECREASE","submitted_at":"2026-07-10 11:54","obligation_date":"2026-07-06","current_ratio_pct":7.14,"previous_ratio_pct":7.43,"change_pct_point":-0.29,"purpose":"純投資","important_proposal":false,"important_proposal_text":"","description":"変更報告書","parent_doc_id":"","source_url":"https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100YPXH"},{"doc_id":"S100YOT0","security_code":"9271","issuer_name":"株式会社和心","filer_name":"一般財団法人日本文化数寄財団","report_type":"変更報告書","event_kind":"CHANGE_OTHER","submitted_at":"2026-07-03 17:05","obligation_date":"2026-06-26","current_ratio_pct":20.19,"previous_ratio_pct":20.19,"change_pct_point":0.0,"purpose":"提出者が組合員となっているELLE有限責任事業組合を通じて発行会社株式を保有しており、その目的は、長期的に発行会社の企業価値向上に寄与することにあります。 / 長期的に発行会社の企業価値向上に寄与すること","important_proposal":false,"important_proposal_text":"","description":"変更報告書","parent_doc_id":"S100YOBK","source_url":"https://disclosure2.edinet-