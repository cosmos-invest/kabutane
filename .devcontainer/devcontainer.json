{
  "name": "かぶたね PRプレビュー",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "かぶたね開発画面",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "nohup python -m http.server 8000 --bind 0.0.0.0 > /tmp/kabutane-preview.log 2>&1 &"
}
